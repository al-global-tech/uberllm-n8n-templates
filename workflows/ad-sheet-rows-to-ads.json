        "jsCode": "// Every row of this run (made ones carry `still` and `clip` as binary), then one summary item.\nconst items = $input.all();\nconst made = items.filter((i) => i.json.made);\nreturn [...items, { json: {\n  summary: true,\n  made: made.length,\n  not_made: items.filter((i) => i.json.made === false).map((i) => ({ name: i.json.name, error: i.json.error })),\n} }];"
