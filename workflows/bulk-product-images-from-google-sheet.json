    {
      "parameters": {
        "jsCode": "// One line that says what this run did. Costs are also in the sheet, one per row.\nconst rows = $input.all().map((i) => i.json).filter((r) => r.row_number !== undefined);\nconst made = rows.filter((r) => r.status === 'made');\nreturn [{ json: {\n  images_made: made.length,\n  rows_not_made: rows.length - made.length,\n  total_cost_usd: Math.round(made.reduce((sum, r) => sum + (Number(r.cost_usd) || 0), 0) * 1e6) / 1e6,\n} }];"
      },
      "id": "b2487d7d-da0f-5ede-a51f-7ba3f38582af",
      "name": "Summary",
