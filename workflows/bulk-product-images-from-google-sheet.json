    {
      "parameters": {
        "jsCode": "// Picks the rows that still need an image and builds the request for each one.\n// A row needs an image when it has a prompt and its image_link cell is empty.\nconst s = $('Settings').first().json;\nconst rows = $input.all().map((i) => i.json).filter((r) => Object.keys(r).length);\nif (!rows.length) throw new Error('The sheet has no rows under the header row. Add a row with a prompt and run again.');\nif (!rows.some((r) => 'prompt' in r)) {\n  throw new Error('The sheet needs a column named prompt (in the first row, lower case). Add it and run again.');\n}\n// One shape setting for both models: text-to-image takes a size, photo edits take a ratio.\nconst SHAPES = { square: ['1024x1024', '1:1'], portrait: ['1024x1536', '2:3'], landscape: ['1536x1024', '3:2'] };\nconst shape = SHAPES[String(s.shape || '').trim().toLowerCase()];\nif (!shape) throw new Error('Settings → shape must be square, portrait or landscape.');\nconst style = String(s.style_for_every_image || '').trim();\nconst limit = Math.max(1, Math.min(200, Number(s.max_rows_per_run) || 20));\nconst text = (v) => String(v ?? '').trim();\n\nconst todo = rows.filter((r) => text(r.prompt) && !text(r.image_link)).slice(0, limit);\nreturn todo.map((r) => {\n  const photo = text(r.photo_link);\n  const prompt = [text(r.prompt), style].filter(Boolean).join('. ');\n  const tags = { template: 'bulk-product-images-sheet', row: String(r.row_number) };\n  return { json: {\n    row_number: r.row_number,\n    file_name: (text(r.product) || 'row-' + r.row_number).replace(/[^\\p{L}\\p{N} _-]+/gu, ' ').trim().slice(0, 80) || 'row-' + r.row_number,\n    api_url: 'https://api.martllm.com/v1/images/' + (photo ? 'edits' : 'generations'),\n    request: photo\n      ? { model: s.photo_edit_model, prompt: prompt + '. Keep the product exactly as it is in the photo: same shape, colours, label and text.',\n          image_url: photo, aspect_ratio: shape[1], max_cost: s.max_cost_per_image, metadata: tags }\n      : { model: s.text_to_image_model, prompt, n: 1, size: shape[0], max_cost: s.max_cost_per_image, metadata: tags },\n  } };\n});"
      },
