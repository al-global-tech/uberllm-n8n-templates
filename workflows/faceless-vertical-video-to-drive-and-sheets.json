    {
      "id": "2324e3a4-0385-5c7f-a2ff-5d4645350b4a",
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "f3fc969d-2260-5e18-a8b1-569934ae2a3f",
              "name": "channel_topic",
              "value": "Calm, surprising facts about the deep ocean",
              "type": "string"
            },
