              "value": "venice/seedance-2-fast-t2v",
              "type": "string"
            },
            {
              "id": "e9d93d46-7a19-5ba1-ad2c-d11a3c5cf0ef",
              "name": "backup_video_models",
              "value": "venice/seedance-2-5-flash-text-to-video-basic",
              "type": "string"
            },
            {
              "id": "f6ae8748-1b59-58c5-a807-720f27901be7",
              "name": "script_model",
              "value": "deepseek/deepseek-v4.1-flash",
              "type": "string"
            },
            {
              "id": "8ffa3003-af76-5d2a-a993-b4223527c07e",
              "name": "max_cost_usd",
              "value": 2,
              "type": "number"
            },
            {
              "id": "b04c260c-85d1-5928-a978-3ef3ba7913cd",
              "name": "script_instructions",
              "value": "You plan one faceless short vertical video (YouTube Shorts, TikTok, Reels) for a channel. You get the channel topic, an idea (or none: then pick a fresh one that fits the topic), the look, the video length in seconds, whether the video has a voice, and titles the channel already made.\n\nWrite ONE continuous vertical shot that a video model can make in that length. Describe the subject, the place, the light and how the camera moves, in plain concrete words. No people on camera, no on-screen text, no logos, no brand names.\n\nIf the video has a voice, a narrator says one short line that fits the length (about 2.5 words per second). Put it at the end of video_prompt in quotes, after 'A calm narrator says:'. If there is no voice, write no spoken line.\n\nNever repeat a title that was already made. State only facts that are true and well known.\n\nAnswer with JSON only: {\"idea\": \"the idea in one sentence\", \"title\": \"at most 60 characters\", \"video_prompt\": \"...\", \"caption\": \"a caption for the post, at most 150 characters\", \"hashtags\": \"3 to 5 hashtags separated by spaces\"}",
              "type": "string"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "name": "Settings",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        220,
        300
      ]
    },
    {
      "id": "e98e83b4-3392-569a-ae1c-6f7e19d6cfbc",
      "parameters": {
        "jsCode": "// Titles this workflow already made, so the daily run does not repeat itself.\n// n8n keeps this memory only for an active workflow run by its schedule; a manual test run starts empty.\nconst made = $getWorkflowStaticData('global').titles || [];\nreturn [{ json: { ...$input.first().json, past_titles: made.slice(-50) } }];"
      },
      "name": "Remember past videos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        440,
        300
      ]
    },
    {
      "id": "678f103f-563c-50ac-aa0b-a9d81bc1161f",
      "parameters": {
        "method": "POST",
        "url": "https://api.martllm.com/v1/chat/completions",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-UberLLM-Source",
              "value": "n8n"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $json.script_model,\n  temperature: 0.9,\n  response_format: { type: 'json_object' },\n  messages: [\n    { role: 'system', content: $json.script_instructions },\n    { role: 'user', content: 'Channel topic: ' + $json.channel_topic + '\\nIdea: ' + ($json.idea || 'none, pick one') + '\\nLook: ' + $json.look + '\\nVideo length: ' + $json.seconds + ' seconds\\nThe video has a voice: ' + ($json.voice ? 'yes' : 'no') + '\\nAlready made: ' + ($json.past_titles.join('; ') || 'nothing yet') }\n  ]\n}) }}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "neverError": true
            }
          }
        }
      },
      "name": "Write the video plan",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        660,
        300
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "martllmApiKey01",
          "name": "MartLLM API key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000
    },
    {
      "id": "8b2fa4b6-89cd-56c3-a207-f23578ee3640",
      "parameters": {
        "jsCode": "const reply = $input.first().json;\nif (reply.error?.message) throw new Error('MartLLM could not write the plan: ' + reply.error.message);\nconst text = reply.choices?.[0]?.message?.content || '';\nconst found = text.match(/\\{[\\s\\S]*\\}/);\nlet plan;\ntry { plan = JSON.parse(found ? found[0] : text); } catch (e) {\n  throw new Error('The writing model did not answer in the expected shape. Run the workflow again, or pick another script_model in Settings.');\n}\nif (!plan.video_prompt || !plan.title) throw new Error('The writing model left out the title or the video prompt. Run the workflow again.');\nconst s = $('Settings').first().json;\n// The request both the price check and the start send, so the price is for exactly this video.\nconst request = {\n  model: s.video_model,\n  prompt: plan.video_prompt + ' Look: ' + s.look + '.',\n  duration_seconds: s.seconds,\n  resolution: s.resolution,\n  aspect_ratio: '9:16',\n  audio: s.voice,\n  max_cost: s.max_cost_usd,\n};\nreturn [{ json: { ...plan, request, script_cost_usd: reply.usage?.cost_usd ?? null } }];"
      },
      "name": "Read the plan",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        880,
        300
      ]
    },
