              "name": "look",
              "value": "Cinematic and realistic, natural light, slow camera moves, no people, no text on screen",
              "type": "string"
            },
            {
              "id": "c09ef199-1b24-5b40-a7e5-4e2c26de278a",
              "name": "seconds",
              "value": 8,
              "type": "number"
            },
