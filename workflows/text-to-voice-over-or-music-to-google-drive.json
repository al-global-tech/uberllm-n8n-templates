    {
      "parameters": {
        "jsCode": "// The track is downloaded. The exact charge can arrive up to 30 seconds after the file,\n// so until then the price given at the start is shown.\nconst item = $input.first();\nconst job = item.json;\nconst start = $('Start the music').first().json;\nconst s = $('Settings').first().json;\nconst final = job.usage?.cost_usd != null;\n// A music model may answer in FLAC or WAV, not MP3: the file keeps the type it came in.\nconst ext = String(item.binary.audio.fileExtension || (item.binary.audio.mimeType || '').split('/')[1] || 'mp3').replace(/^x-/, '');\nconst fileName = s.file_name.replace(/\\.mp3$/, '.' + ext);\nreturn [{\n  json: { kind: 'Music', file_name: fileName, cost_usd: final ? job.usage.cost_usd : (start.estimated_cost_usd ?? null), cost_is_final: final, request_id: job.id },\n  binary: { audio: { ...item.binary.audio, fileName } },\n}];"
      },
      "id": "78dcd873-2a23-5800-9b57-cf40d10902c4",
      "name": "Read the music",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2200,
        -100
      ]
    },
