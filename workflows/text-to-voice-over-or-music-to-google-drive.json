    {
      "parameters": {
        "method": "POST",
        "url": "https://api.martllm.com/v1/audio/speech",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "X-UberLLM-Source",
              "value": "n8n"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({\n  model: $json.voice_model,\n  input: $json.text,\n  voice: $json.voice,\n  response_format: 'mp3',\n  max_cost: $json.max_cost_usd,\n  metadata: { template: 'text-to-audio-drive' }\n}) }}",
        "options": {
          "timeout": 180000,
          "response": {
            "response": {
              "fullResponse": true,
              "neverError": true,
              "responseFormat": "file",
              "outputPropertyName": "audio"
            }
          }
        }
      },
      "id": "addcd950-e942-56ab-956b-f4de1ef01760",
      "name": "Make the voice-over",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        880,
        360
      ],
      "credentials": {
        "httpHeaderAuth": {
          "id": "martllmApiKey01",
          "name": "MartLLM API key"
        }
      },
      "retryOnFail": true,
      "maxTries": 3,
      "waitBetweenTries": 5000,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "// The answer is the audio file itself. Its cost and request id come in the headers.\n// When the API refuses, the \"file\" is its JSON error: read it and stop with its message.\nconst item = $input.first();\nconst h = item.json.headers || {};\nif (item.json.error && !item.binary) throw new Error(typeof item.json.error === 'string' ? item.json.error : (item.json.error.message || 'The voice-over was not made.'));\nif (Number(item.json.statusCode) >= 400) {\n  let why = 'The voice-over was not made (HTTP ' + item.json.statusCode + '). Nothing was charged.';\n  try {\n    const body = JSON.parse((await this.helpers.getBinaryDataBuffer(0, 'audio')).toString('utf8'));\n    if (body.error?.message) why = body.error.message;\n  } catch (e) { /* not JSON: keep the plain message */ }\n  throw new Error(why);\n}\nconst s = $('Settings').first().json;\nconst cost = h['x-uberllm-cost-usd'];\nreturn [{\n  json: { kind: 'Voice-over', file_name: s.file_name, cost_usd: cost != null ? Number(cost) : null, cost_is_final: true, request_id: h['x-request-id'] || null },\n  binary: { audio: { ...item.binary.audio, fileName: s.file_name } },\n}];"
      },
